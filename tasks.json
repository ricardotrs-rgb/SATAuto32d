{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run SAT32D Web",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				".vscode/start_sat32d_web.py"
			],
			"group": "build",
			"presentation": {
				"panel": "dedicated",
				"reveal": "never",
				"close": true
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		}
	]
}